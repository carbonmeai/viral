{
  "name": "@viral/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Viral: turn long videos into viral shorts",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "vp pack",
    "start": "electron .",
    "dev": "node scripts/dev.ts",
    "fetch-tools": "node scripts/fetch-tools.ts",
    "package": "vp pack && node scripts/build-server.ts && electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "effect": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.16.1",
    "vite-plus": "1.4.0"
  },
  "productName": "Viral"
}
