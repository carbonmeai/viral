{
  "name": "viral",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "effect-tsgo tsc -p tsconfig.json && effect-tsgo tsc -p packages/ui/tsconfig.json && effect-tsgo tsc -p apps/web/tsconfig.json",
    "dev:server": "node --env-file-if-exists=.env --watch apps/server/src/main.ts",
    "cli": "node apps/cli/src/main.ts",
    "test": "node --env-file-if-exists=.env --test \"apps/**/*.test.ts\" \"packages/**/*.test.ts\"",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "repos:sync": "node scripts/sync-repos.ts",
    "fixtures:sync": "node scripts/sync-fixtures.ts",
    "test:golden": "node --env-file-if-exists=.env --test \"apps/**/*.golden.ts\"",
    "start:server": "node --env-file-if-exists=.env apps/server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "7.0.2",
    "@effect/tsgo": "0.67.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
